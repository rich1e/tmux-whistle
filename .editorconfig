root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# shfmt 与编辑器共用同一份缩进/续行风格。
# 方言（-ln=posix / -ln=bash）不能写在这里，按路径在 Makefile 里分两次调用。
[*.sh]
indent_style = space
indent_size = 2
binary_next_line = true
space_redirects = true
switch_case_indent = true

[*.bats]
indent_style = space
indent_size = 2
binary_next_line = true

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false