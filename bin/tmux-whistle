#!/bin/sh
# tmux-whistle — tmux 内跨 session 的 agent 状态通知
#
# 唯一状态写入点。agent 调它写状态，状态栏与各渠道读它渲染。

# 解析符号链接后再定位 lib/。
# 安装时 bin/tmux-whistle 被链接到 ~/.local/bin，此时 $0 是链接路径，
# 直接 dirname 会得到 ~/.local/lib —— 找不到模块，整个 CLI 不可用。
# macOS 的 readlink 没有 -f，所以自己循环解析。
_whistle_self="$0"
while [ -L "$_whistle_self" ]; do
  _whistle_link=$(readlink "$_whistle_self") || break
  case "$_whistle_link" in
  /*) _whistle_self="$_whistle_link" ;;
  *) _whistle_self="$(dirname -- "$_whistle_self")/$_whistle_link" ;;
  esac
done
WHISTLE_BIN_DIR=$(CDPATH='' cd -- "$(dirname -- "$_whistle_self")" && pwd)
WHISTLE_LIB_DIR=$(CDPATH='' cd -- "$WHISTLE_BIN_DIR/../lib" && pwd)
unset _whistle_self _whistle_link

for _m in core status-line deliver; do
  if [ ! -f "$WHISTLE_LIB_DIR/$_m.sh" ]; then
    printf 'tmux-whistle: 缺少 lib/%s.sh（安装不完整？）\n' "$_m" >&2
    exit 1
  fi
  # shellcheck source=lib/core.sh
  . "$WHISTLE_LIB_DIR/$_m.sh"
done
unset _m

WHISTLE_PROG=$(basename "$0")
WHISTLE_SELF=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)/$WHISTLE_PROG

whistle_usage() {
  cat << EOF
$WHISTLE_PROG — tmux 内跨 session 的 agent 状态通知

用法：
  $WHISTLE_PROG <状态> [消息]        置状态：done | wait | error | running
  $WHISTLE_PROG run [-- 标签] -- 命令 [参数...]
                                     包一个命令：按退出码落 done / error，带耗时
  $WHISTLE_PROG clear [-a]           清除当前窗口 / 全部待处理状态
  $WHISTLE_PROG list                 列出所有待处理项
  $WHISTLE_PROG menu                 打开 agent 菜单（等同 prefix + n）
  $WHISTLE_PROG jump <窗口|序号|sess:win>
                                     跳到指定窗口并清除
  $WHISTLE_PROG on | off             总开关
  $WHISTLE_PROG doctor               环境自检

选项：
  -t, --target <pane|window>        指定目标（默认当前 pane）
      --title <短标题>              徽章上显示的文字（上限 80 字符）
      --body <正文>                完整内容，存进 @whistle_body（上限 400）
      --dry-run                     只打印会做什么，不执行

Claude Code 集成：
  $WHISTLE_PROG install-hooks [--dry-run] [--uninstall]

配置（tmux 里 set -g @whistle_xxx）：
  @whistle_enabled on|off            总开关（默认 on）
  @whistle_badge on|off              窗口标签徽章（默认 on）
  @whistle_border on|off             面板边框变色（默认 on）
  @whistle_display on|off            状态栏瞬时提示（默认 on）
  @whistle_os on|off                 桌面系统通知（默认 off）
  @whistle_self on|off               是否也提示自己所在的 session（默认 off）
  @whistle_clear_on_focus on|off     切进窗口自动清除（默认 on）
  @whistle_color_done|wait|error|running   徽章与边框颜色
  @whistle_icon_done|wait|error|running    各状态的图标（默认 ◆ / ◷ / ⚠ / ▶）
  @whistle_icon_pending              全局计数前的图标（默认 ✉；空串 = 不显示）
EOF
}

whistle_die() {
  printf '%s: %s\n' "$WHISTLE_PROG" "$*" >&2
  exit 1
}

# -- 置状态 ----------------------------------------------------------------

# cmd_set <state> [选项...] [消息...]
#
# 消息与选项的顺序无关 —— 早期版本直接把 $2 当消息，于是
# `done -t %3 "消息"`（git 那种习惯）会把 -t 吃进消息、写错 pane。
# 现在统一走一个循环：-t 收下一个参数，-- 之后全是消息，其余逐词拼消息。
# whistle_finish <pane> <状态> <原始消息>
#
# 写完状态之后的统一编排：重算窗口与全局计数，然后投递。
# cmd_set 与 cmd_run 共用 —— 复制两份必然分叉。
whistle_finish() {
  _ff_pane="$1"
  _ff_state="$2"
  _ff_msg="$3"

  _ff_win=$(whistle_pane_window "$_ff_pane")
  [ -n "$_ff_win" ] || return 1

  whistle_recompute_window "$_ff_win"
  whistle_recompute_global
  whistle_deliver "$_ff_win" "$_ff_state" "$(whistle_sanitize "$_ff_msg")"
}

cmd_set() {
  _state="$1"
  shift

  _msg=''
  _target=''
  _dry=0
  _title=''
  _body=''
  while [ $# -gt 0 ]; do
    case "$1" in
    -t | --target)
      _target="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    --title)
      _title="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    --body)
      _body="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    --dry-run)
      _dry=1
      shift
      ;;
    --)
      shift
      while [ $# -gt 0 ]; do
        _msg="${_msg:+$_msg }$1"
        shift
      done
      ;;
    -*)
      whistle_die "未知选项 [$1]"
      ;;
    *)
      _msg="${_msg:+$_msg }$1"
      shift
      ;;
    esac
  done

  # 徽章上显示什么，优先级：--title > 位置消息 > --body 的前 80 字。
  # 三者都不给就是空 —— 与改动前逐字一致。
  # 之所以让 --body 能顶上来：只写 --body 时若消息留空，徽章就是空白，
  # 而正文的内容明明就在手上。
  if [ -n "$_title" ]; then
    _msg="$_title"
  elif [ -z "$_msg" ] && [ -n "$_body" ]; then
    _msg="$_body"
  fi

  if [ "$_dry" = 1 ]; then
    printf '将置 %s = "%s"（目标 %s）\n' "$_state" "$_msg" "${_target:-${TMUX_PANE:-当前 pane}}"
    return 0
  fi

  _pane=$(whistle_state_set "$_state" "$_msg" "$_target" "$_body") || exit 1
  whistle_finish "$_pane" "$_state" "$_msg" || whistle_die "拿不到 pane $_pane 所属窗口"
}

# -- 命令包装器 -------------------------------------------------------------

# cmd_run [-- 标签] [--target <pane>] -- 命令 [参数...]
#
# 替手写 `cmd && whistle done "…" || whistle error "…"`：那种写法漏了后半截
# 或把 && || 写反都**不报错**，只是徽章不对。包装器按退出码决定终态，
# 顺带把耗时记进消息。
#
# 只认退出码，不解析输出 —— 它没法知道一个退出码 0 的命令是不是"真的完成了"。
# 这是显式包装器的边界，不是缺陷。
#
# ⚠️ 不要用 exec：那会替换掉当前 shell 进程，拿不到退出码。
# 直接跑 "$@" 再读 $? 即可。
#
# ⚠️ 但必须给 SIGINT 装一个 no-op handler。Ctrl-C 把信号发给**整个前台进程组**，
# 不装的话 /bin/sh 跑的包装器会在读到 $? 之前就死掉 —— 状态永远停在 running，
# 而 running 不计入 pending、✉ 不亮，非 Claude Code 的进程更没有 SessionEnd
# 兜底，那盏 ● 就再也灭不掉了。
#
# 必须用 ':'（no-op）而不是 ''（ignore）：被 **trap** 的信号在子进程里复位成
# 默认动作，子命令照样能被 Ctrl-C 打断；被 ignore 的信号会连子进程一起忽略 ——
# 那样用户按 Ctrl-C 就再也停不掉自己启动的构建了。
cmd_run() {
  trap ':' INT

  _label=''
  _target=''

  # 解析到 -- 为止：选项归选项，其余逐词拼成标签。
  while [ $# -gt 0 ]; do
    case "$1" in
    -t | --target)
      _target="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      whistle_die "未知选项 [$1]"
      ;;
    *)
      _label="${_label:+$_label }$1"
      shift
      ;;
    esac
  done

  [ $# -gt 0 ] \
    || whistle_die "用法：$WHISTLE_PROG run [-- 标签] -- 命令 [参数...]"

  # 没给标签就用命令名。$@ 原样传给 "$@" —— 不 eval、不 word splitting，
  # 用户引号怎么写就怎么传。
  _label="${_label:-$1}"

  _pane=$(whistle_state_set running "$_label" "$_target") || exit 1
  whistle_finish "$_pane" running "$_label" || whistle_die "拿不到 pane $_pane 所属窗口"

  _start=$(whistle_now)
  "$@"
  _rc=$?
  _dur=$(($(whistle_now) - _start))

  if [ "$_rc" -eq 0 ]; then
    _state='done'
    _msg="$_label 完成（${_dur}s）"
  else
    _state='error'
    # ${_rc} 必须带括号：$_rc 紧跟全角逗号时 bash 会把「，」的第一个字节
    # 吞进变量名，字符串变成非法 UTF-8，tr 直接报 Illegal byte sequence
    # 并把消息截在逗号前。踩过，见 CLAUDE.md 的 POSIX sh 红线。
    _msg="$_label 失败（退出码 ${_rc}，${_dur}s）"
  fi

  whistle_state_set "$_state" "$_msg" "$_pane" > /dev/null
  whistle_finish "$_pane" "$_state" "$_msg"

  # 透传子命令的退出码 —— 否则 `make && tmux-whistle run -- …` 失败时会返回 0。
  exit "$_rc"
}

# -- 清除 ------------------------------------------------------------------

# whistle_select_pane_if_alive <pane>
#
# 选中一个 pane，但**先判它还在不在**。不判的话，对着已死的 pane 发
# select-pane 会报错，而 tmux 的 `;` 命令链遇错即停 —— 后面的清除就不执行，
# 状态永远清不掉。
#
# 两个调用点都是这个 hazard：`jump`（用户手敲的窗口名）与菜单（开着的时候
# 那一格被关掉）。抽出来是为了两处共用同一套判断，别各写一份。
#
# 判存活用 display-message -p -t <pane>：不存在的 pane 会返回非零。
whistle_select_pane_if_alive() {
  _sp_pane="${1:-}"
  [ -n "$_sp_pane" ] || return 0
  whistle_tmux display-message -p -t "$_sp_pane" '#{pane_id}' > /dev/null 2>&1 || return 0
  whistle_tmux select-pane -t "$_sp_pane" 2> /dev/null || true
}

cmd_clear() {
  _all=0
  _target=''
  _select=''
  while [ $# -gt 0 ]; do
    case "$1" in
    -a | --all)
      _all=1
      shift
      ;;
    -t | --target)
      _target="$2"
      shift 2
      ;;
    --select)
      _select="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    *)
      _target="$1"
      shift
      ;;
    esac
  done

  if [ "$_all" = 1 ]; then
    whistle_clear_all
    whistle_border_release_all
    whistle_border_status_release_all
    whistle_refresh_all
    return 0
  fi

  _win=$(whistle_tmux display-message -p -t "${_target:-}" '#{window_id}' 2> /dev/null)
  [ -n "$_win" ] || _win=$(whistle_pane_window "$(whistle_resolve_pane "$_target")")
  [ -n "$_win" ] || whistle_die "找不到目标窗口"
  whistle_clear_window "$_win"
  whistle_border_release "$_win"
  whistle_border_status_release "$_win"
  whistle_refresh_sessions "$_win"

  # 菜单跳转会带 --select：先清、后选，即便 select 失败也不影响清除结果
  whistle_select_pane_if_alive "$_select"
}

# -- 列表 ------------------------------------------------------------------

cmd_list() {
  _rows=$(whistle_list_lines)
  if [ -z "$_rows" ]; then
    printf '没有待处理的 whistle。\n'
    return 0
  fi

  printf '%-14s %-12s %-5s %-8s %-8s %s\n' SESSION WINDOW PANE STATE MSG AGE
  # here-doc 重定向而非管道：管道会把循环塞进子 shell
  while IFS='|' read -r s w p st m a; do
    printf '%-14s %-12s %-5s %-8s %-8s %s\n' "$s" "$w" "$p" "$st" "$m" "$a"
  done << EOF
$_rows
EOF
  _n=$(printf '%s\n' "$_rows" | wc -l | tr -d ' ')
  printf '\n共 %s 项待处理。按 prefix + n 打开菜单跳转。\n' "$_n"
}

# -- 菜单 / 跳转 -----------------------------------------------------------

# display-menu 的键位是单字符：1-9 之后接字母，最多 26 项（9 + 17 = a..q）
#
# 两个坑叠在一起，症状相同（第 10 项起 key 为空）：
#   1. 位置算成了 $1 - 10，第 10 项得到 0 —— cut 不接受 0
#   2. 算术展开后面多写了一个 ')'，cut 实际收到的是 "1)" 而不是 "1"
# 两者都让 cut 报错；stderr 被 2>/dev/null 吞掉，key 变成空串。
# 空 key 在 display-menu 里**合法**（表示"无快捷键"），所以菜单照常弹出、
# 只是第 10 项往后全都不能用键选中 —— 不报错、不崩溃，只能靠断言抓。
#
# 位置单独算进变量：嵌套三层 $() 加引号里再塞算术，少一个括号看不出来。
whistle_menu_key() {
  case "$1" in
  [1-9]) printf '%s' "$1" ;;
  *)
    _mk_pos=$(($1 - 9))
    printf '%s' "$(printf '%s' abcdefghijklmnopqrstuvwxyz | cut -c "$_mk_pos" 2> /dev/null)"
    ;;
  esac
}

# whistle_menu_overflow <被藏起来的项数> → 菜单里那条灰字提示的名字
#
# display-menu 每项一个单字符快捷键：9 个数字 + a~q 17 个字母 = 26 项是硬上限。
# 截断本身合理，问题是**静默** —— 状态栏写着 ✉28、菜单里只有 26 项，
# 用户会以为自己记错了，而不是「哦有条目被折叠了」。
#
# 提示项以 '-' 开头：tmux 绘制时会剥掉那个 '-' 并置暗（disabled 语义），
# 选中与鼠标路径都会跳过它；快捷键传空串，命令是空转。
# **快捷键必须为空** —— 非空的话用户按那个键会选中一条不可跳转的项，
# 行为上就退化成了「点了没反应」，比原来的静默截断更难查。
whistle_menu_overflow() {
  printf -- '- 还有 %s 项未显示，用 %s list 查看' "${1:-0}" "$WHISTLE_PROG"
}

# whistle_menu_running_label <状态> <session> <窗口> <消息>
#
# running 项的菜单标签，前缀是一个动画帧。
#
# 菜单是**瞬时弹出**的 —— 弹出那一瞬间拍一张快照就冻结了，不需要 format 在
# 渲染时求值。所以这里用 shell 直接取当前帧，而不是塞一段
# `#{?...}` 条件式（display-menu 的条目名是否会展开 format，我们没有验证过，
# 不拿它冒险）。
#
# 颜色取自 @whistle_color_running（默认 #00af00 绿）。想让它换色：
#   set -g @whistle_color_running '#5faf00'
#
# 抽成函数是因为 cmd_menu 与 cmd_menu_args 必须逐字相同 —— 改一边不改另一边，
# 测试就会变假绿（这个坑踩过一次）。
whistle_menu_running_label() {
  if [ "$(whistle_conf '@whistle_spin')" = on ]; then
    _mr_icon=$(whistle_spin_char)
  else
    _mr_icon=$(whistle_icon '@whistle_icon_running')
  fi
  printf '#[fg=%s]%s#[default] %s %s:%s %s' \
    "$(whistle_conf '@whistle_color_running')" "$_mr_icon" \
    "$(whistle_state_label "$1")" "$2" "$3" "${4:-}"
}

cmd_menu() {
  _items=$(whistle_agent_windows)
  if [ -z "$_items" ]; then
    # 两条路都要说一声：交互时 stdout 会被 run-shell -b 丢掉，只能靠
    # display-message 落到状态行；脚本里没有 client，则只能靠 stdout。
    printf '没有 agent 上报过状态。\n'
    whistle_tmux display-message '没有 agent 上报过状态' 2> /dev/null || true
    return 0
  fi

  # 用 set -- 累积 argv：菜单 label 里有空格，靠单词切分传参会散架。
  #
  # 两遍扫描同一份数据（待处理先、running 后），但**共用同一个键位计数器**：
  # 两类都能点、都能跳。区别只在标记与语义 ——
  #
  #   待处理项   前缀空格，选中后顺带清除（你到现场了 = 已读）
  #   running   前缀绿色 ▶（whistle_menu_running_label），只是跳过去看看；
  #             clear 对 running 本身是空操作
  #             （whistle_clear_window 只清 whistle_is_notified 的状态）
  #
  # 键位总预算 26（9 个数字 + a~q 17 个字母），两类共享同一串序号。
  # 待处理排前面，所以待处理多的时候 running 会先被挤掉 —— 这是对的优先级。
  #
  # 超出上限时**不静默截断**：一直计数，只在 ≤26 时累积，放不下就在末尾
  # 追加一条灰字提示。状态栏写着 ✉28 而菜单只有 26 项，用户会以为自己记错了。
  set --
  _i=0
  _total=0
  while IFS='|' read -r s wid wn _wi _pid st msg; do
    whistle_is_notified "$st" || continue
    _i=$((_i + 1))
    _total=$((_total + 1))
    [ "$_i" -gt 26 ] && continue
    _label=" $(whistle_state_label "$st") $s:$wn $msg"
    set -- "$@" "$_label" "$(whistle_menu_key "$_i")" \
      "switch-client -t $s ; select-window -t $wid ; run-shell -b '$WHISTLE_SELF clear -t $wid --select $_pid'"
  done << EOF
$_items
EOF

  while IFS='|' read -r s wid wn _wi _pid st msg; do
    whistle_is_notified "$st" && continue
    _i=$((_i + 1))
    _total=$((_total + 1))
    [ "$_i" -gt 26 ] && continue
    _label="$(whistle_menu_running_label "$st" "$s" "$wn" "$msg")"
    set -- "$@" "$_label" "$(whistle_menu_key "$_i")" \
      "switch-client -t $s ; select-window -t $wid ; run-shell -b '$WHISTLE_SELF clear -t $wid --select $_pid'"
  done << EOF
$_items
EOF

  if [ "$_total" -gt 26 ]; then
    set -- "$@" "$(whistle_menu_overflow $((_total - 26)))" '' "display-message ''"
  fi

  # display-menu 需要一个 attached client；在脚本里调用（无头 server）时
  # 它会报 "no current client"。这时降级成纯文本列表，而不是静默失败。
  #
  # `--` 不能省：disabled 条目的名称以 '-' 开头，而 tmux 的参数解析会在
  # 遇到第一个非选项参数后才停止把 '-' 当 flag（tmux 3.2 用 getopt，
  # 3.8 用 arguments.c，两者都认 '--'）。少了它会报 "invalid flag -"。
  if ! whistle_tmux display-menu -T 'tmux-whistle' -- "$@" 2> /dev/null; then
    printf '没有可用的客户端。在 tmux 会话里按 prefix + n 打开菜单。\n\n'
    while IFS='|' read -r s wid wn _wi _pid st msg; do
      if whistle_is_notified "$st"; then
        printf '  %s  %s:%s  %s\n' "$(whistle_state_label "$st")" "$s" "$wn" "$msg"
      else
        # 纯文本降级，没有菜单可选中，所以不带样式转义（那会原样显示出来）
        printf '▶ %s  %s:%s  %s\n' "$(whistle_state_label "$st")" "$s" "$wn" "$msg"
      fi
    done << EOF
$_items
EOF
  fi
}

# 调试/测试用：逐行打印菜单的 argv（每个参数一行）。
# 用于在不依赖 attached client 的情况下验证参数构造。
cmd_menu_args() {
  _items=$(whistle_agent_windows)
  [ -n "$_items" ] || return 0

  # 与 cmd_menu 的两遍扫描逐行对应 —— 改一边不改另一边，测试就会变假绿。
  _i=0
  _total=0
  while IFS='|' read -r s wid wn _wi _pid st msg; do
    whistle_is_notified "$st" || continue
    _i=$((_i + 1))
    _total=$((_total + 1))
    [ "$_i" -gt 26 ] && continue
    printf '%s\n' " $(whistle_state_label "$st") $s:$wn $msg"
    printf '%s\n' "$(whistle_menu_key "$_i")"
    printf '%s\n' "switch-client -t $s ; select-window -t $wid ; run-shell -b '$WHISTLE_SELF clear -t $wid --select $_pid'"
  done << EOF
$_items
EOF

  while IFS='|' read -r s wid wn _wi _pid st msg; do
    whistle_is_notified "$st" && continue
    _i=$((_i + 1))
    _total=$((_total + 1))
    [ "$_i" -gt 26 ] && continue
    printf '%s\n' "$(whistle_menu_running_label "$st" "$s" "$wn" "$msg")"
    printf '%s\n' "$(whistle_menu_key "$_i")"
    printf '%s\n' "switch-client -t $s ; select-window -t $wid ; run-shell -b '$WHISTLE_SELF clear -t $wid --select $_pid'"
  done << EOF
$_items
EOF

  if [ "$_total" -gt 26 ]; then
    printf '%s\n' "$(whistle_menu_overflow $((_total - 26)))"
    printf '%s\n' ''
    printf '%s\n' "display-message ''"
  fi
}

cmd_jump() {
  [ -n "${1:-}" ] || whistle_die "用法：$WHISTLE_PROG jump <窗口名|窗口序号|session:窗口>"
  _target="$1"

  # 认四种形式：session:窗口名、session:窗口序号、裸窗口名、裸窗口序号。
  # 裸窗口名是 list 输出的第二列，用户会照着抄 —— 不认它就等于报错说
  # 「找不到」，而那个窗口明明就在那儿。
  #
  # **撞名时报错列候选，不静默取第一个**：裸序号 0 在每个 session 里都存在，
  # 裸窗口名也可能重名。跳错窗口比报错难查得多 —— 你到了另一个 session，
  # 看见一个干净窗口，根本想不起来「哦原来该跳的是另一个」。
  #
  # 一个窗口最多命中一支（$3 == t 与 $4 == t 互斥：窗口名不可能等于序号）。
  # 候选一律显示 session:窗口名，用户能直接粘回来用。
  _hits=$(whistle_tmux list-windows -a \
    -F '#{session_name}|#{window_id}|#{window_name}|#{window_index}' 2> /dev/null \
    | awk -F'|' -v t="$_target" \
      '$1 ":" $3 == t || $1 ":" $4 == t || $3 == t || $4 == t { print $2 "|" $1 ":" $3 }')

  [ -n "$_hits" ] || whistle_die "找不到 [$_target]"

  _n=$(printf '%s\n' "$_hits" | wc -l | tr -d ' ')
  if [ "$_n" -gt 1 ]; then
    _list=$(printf '%s\n' "$_hits" | cut -d'|' -f2 | sort)
    printf '%s: [%s] 匹配到 %s 个窗口，请写 session:window：\n' \
      "$WHISTLE_PROG" "$_target" "$_n" >&2
    printf '%s\n' "$_list" | sed 's/^/  /' >&2
    exit 1
  fi

  _wid=${_hits%%|*}
  whistle_tmux switch-client -t "$_wid" 2> /dev/null || true

  # 顺带选中报状态的那一格。
  # **必须先判存活**：select-pane 对着已死的 pane 会报错，而 tmux 的 `;`
  # 命令链遇错即停 —— 后面的 whistle_clear_window 就不会执行，状态永远清不掉。
  # 这正是「菜单开着的时候那一格被关掉」的场景。判断逻辑与菜单路径共用。
  whistle_select_pane_if_alive "$(whistle_tmux show -wv -t "$_wid" @whistle_win_pane 2> /dev/null)"

  whistle_clear_window "$_wid"
}

# -- 开关 ------------------------------------------------------------------

cmd_toggle() {
  _v=$1
  case "$_v" in
  on | off) ;;
  *) whistle_die "用法：$WHISTLE_PROG on|off" ;;
  esac
  whistle_tmux set -g @whistle_enabled "$_v"
  whistle_tmux display-message "whistle: $_v"
}

# -- 内部子命令（供 hook / 绑定调用） ---------------------------------------

cmd_recompute() {
  _wins=$(whistle_tmux list-windows -a -F '#{window_id}' 2> /dev/null)
  for _w in $_wins; do
    whistle_recompute_window "$_w"
  done
  whistle_recompute_global
}

cmd_read_window() {
  _win="${1:-}"
  [ -n "$_win" ] || return 0
  whistle_read_window "$_win" || return 0
  whistle_border_release "$_win"
  whistle_border_status_release "$_win"
  whistle_refresh_sessions "$_win"
}

cmd_read_pane() {
  _pane="${1:-}"
  [ -z "$_pane" ] && _pane=$(whistle_resolve_pane '')
  [ -z "$_pane" ] && return 1

  # 先看是否真的待处理，避免无谓的重算与重绘
  _s=$(whistle_tmux show -pqv -t "$_pane" @whistle 2> /dev/null)
  whistle_is_notified "$_s" || return 0

  whistle_read_pane "$_pane" || return 0
  _win=$(whistle_pane_window "$_pane")
  whistle_border_release "$_win"
  whistle_border_status_release "$_win"
  whistle_refresh_sessions "$_win"
}

# agent 退出（SessionEnd hook）时清掉该 pane 的 running。
#
# running 是「正在干活」的临时标记，agent 走了就该灭 —— 否则窗口会一直亮 ●。
# 只清 running：done/wait/error 是待处理通知，agent 退出不代表你已经看过。
cmd_forget_running() {
  _pane="${1:-}"
  [ -z "$_pane" ] && _pane=$(whistle_resolve_pane '')
  [ -z "$_pane" ] && return 0

  _win=$(whistle_clear_pane_state "$_pane" running) || return 0
  [ -n "$_win" ] || return 0

  # 窗口清空后才还原边框。若还剩别的待处理状态，边框已经是它的颜色，别动。
  _left=$(whistle_tmux show -wv -t "$_win" @whistle_win 2> /dev/null) || _left=''
  if [ -z "$_left" ]; then
    whistle_border_release "$_win"
    whistle_border_status_release "$_win"
  fi
  whistle_refresh_sessions "$_win"
}

cmd_print_status_line() {
  whistle_print_status_line
}

# -- doctor ----------------------------------------------------------------

cmd_doctor() {
  _ok=0
  _warn=0

  _ok_line() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
  _warn_line() {
    printf '  \033[33m!\033[0m %s\n' "$1"
    _warn=$((_warn + 1))
  }
  _bad_line() {
    printf '  \033[31m✗\033[0m %s\n' "$1"
    _ok=1
  }

  printf '\ntmux-whistle doctor\n\n'

  printf 'tmux\n'
  if ! command -v tmux > /dev/null 2>&1; then
    _bad_line 'tmux 不在 PATH'
  else
    _ver=$(tmux -V | awk '{print $2}')
    _ok_line "tmux $_ver"
    _maj=${_ver%%.*}
    _min=$(printf '%s' "$_ver" | cut -d. -f2)
    if [ "$_maj" -lt 3 ] || { [ "$_maj" -eq 3 ] && [ "$_min" -lt 2 ]; }; then
      _bad_line '需要 tmux >= 3.2（run-shell -b / refresh-client -S / pane-border-status）'
    fi
    if ! whistle_tmux display-message -p '#{session_id}' > /dev/null 2>&1; then
      _bad_line '连不上 tmux server（在 tmux 内运行，或设置 TMUX_SOCKET）'
    fi
  fi

  printf '\n状态栏\n'
  _fmt=$(whistle_tmux show -gwv window-status-format 2> /dev/null)
  _n=$(printf '%s' "$_fmt" | grep -o -F "$WHISTLE_MARK_SENTINEL" | wc -l | tr -d ' ')
  if [ "$_n" = 1 ]; then
    _ok_line '徽章已注入 window-status-format'
  elif [ "$_n" -gt 1 ]; then
    _bad_line "哨兵出现 $_n 次（重复注入了）—— 跑 install.sh --uninstall 后重装"
  else
    _warn_line '未注入。跑 make install，或手动加 tmux_conf_theme_window_status_format'
  fi

  printf '\n投递渠道\n'
  for _c in badge border display os; do
    _v=$(whistle_conf "@whistle_$_c")
    printf '  %-8s %s\n' "$_c" "$_v"
  done

  if [ "$(whistle_conf '@whistle_os')" = on ]; then
    if command -v terminal-notifier > /dev/null 2>&1; then
      _ok_line 'terminal-notifier 可用'
    elif command -v osascript > /dev/null 2>&1; then
      osascript -e 'display notification "tmux-whistle doctor 测试" with title "tmux-whistle"' \
        > /dev/null 2>&1 || true
      _warn_line '已发 osascript 测试通知。没看到弹窗 → 系统设置 > 通知 > Script Editor 打开"允许通知"'
    elif command -v notify-send > /dev/null 2>&1; then
      notify-send 'tmux-whistle' 'doctor 测试' > /dev/null 2>&1 || true
      _ok_line 'notify-send 可用'
    else
      _bad_line '没有可用的桌面通知命令'
    fi
  else
    _warn_line '@whistle_os 是 off。要开：set -g @whistle_os on'
  fi

  printf '\n已读钩子\n'
  for _h in after-select-window after-select-pane window-pane-changed; do
    if whistle_tmux show-hooks -gw "$_h" 2> /dev/null | grep -q whistle; then
      _ok_line "$_h 已注册"
    else
      _warn_line "$_h 未注册"
    fi
  done

  printf '\nClaude Code hooks\n'
  _settings="${HOME}/.claude/settings.json"
  if [ -f "$_settings" ]; then
    if grep -q 'tmux-whistle' "$_settings" 2> /dev/null; then
      _ok_line "$_settings 已配置"
    else
      _warn_line '未配置。跑 tmux-whistle install-hooks'
    fi
  else
    _warn_line "找不到 $_settings"
  fi

  printf '\n失效的旧绑定\n'
  # list-keys 的输出是多空格对齐的（"bind-key    -T prefix C-m     ..."），
  # 所以模式必须容忍任意空白，不能用单个空格。
  _stale=0
  for _k in C-m M-m M; do
    _cmd=$(whistle_tmux list-keys -T prefix 2> /dev/null \
      | grep -E "prefix +${_k} +" | grep -F 'tmux-notify' || true)
    [ -n "$_cmd" ] || continue

    # 从命令里抠出脚本路径
    _path=$(printf '%s' "$_cmd" | grep -oE '/[^ "'"'"']*tmux-notify[^ "'"'"']*' | head -1)
    _dir=${_path%/*}
    if [ -n "$_dir" ] && [ -d "$_dir" ]; then
      printf '  - prefix %s → tmux-notify（目录存在）\n' "$_k"
    else
      printf '  \033[33m!\033[0m prefix %s → tmux-notify，但脚本已不存在。跑 install.sh --cleanup 清理。\n' "$_k"
      _warn=$((_warn + 1))
      _stale=1
    fi
  done
  [ "$_stale" = 1 ] || printf '  - 无\n'

  printf '\n'
  if [ "$_ok" = 1 ]; then
    printf '有问题项请先修掉再继续。\n\n'
    exit 1
  fi
  if [ "$_warn" -gt 0 ]; then
    printf '%s 项提醒（非致命）。\n\n' "$_warn"
  else
    printf '一切正常。\n\n'
  fi
}

# -- 分派 ------------------------------------------------------------------

[ $# -gt 0 ] || {
  whistle_usage
  exit 1
}

case "$1" in
done | wait | error | running)
  cmd_set "$@"
  ;;
run)
  shift
  cmd_run "$@"
  ;;
clear)
  shift
  cmd_clear "$@"
  ;;
list | ls)
  shift
  cmd_list "$@"
  ;;
menu)
  shift
  cmd_menu "$@"
  ;;
jump)
  shift
  cmd_jump "$@"
  ;;
on | off)
  # 必须先用 $1 再 shift —— 先 shift 会把子命令本身吃掉
  cmd_toggle "$1"
  ;;
doctor)
  shift
  cmd_doctor "$@"
  ;;
install-hooks)
  shift
  exec "$WHISTLE_BIN_DIR/../lib/install-hooks.sh" "$@"
  ;;
-h | --help | help)
  whistle_usage
  ;;
--read-window)
  shift
  cmd_read_window "${1:-}"
  ;;
--read-pane)
  shift
  cmd_read_pane "${1:-}"
  ;;
--clear-pane)
  shift
  cmd_forget_running "${1:-}"
  ;;
--recompute)
  shift
  cmd_recompute
  ;;
--print-status-line)
  shift
  cmd_print_status_line
  ;;
--menu-args)
  shift
  cmd_menu_args
  ;;
*)
  whistle_usage
  exit 1
  ;;
esac
