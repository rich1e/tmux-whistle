#!/bin/sh
# tmux-whistle — tmux 内跨 session 的 agent 状态通知
#
# 唯一状态写入点。agent 调它写状态，状态栏与各渠道读它渲染。

# 唯一版本真源。构建日期与流水号在发布时更新，不在运行时取当天日期。
WHISTLE_VERSION='0.1.0-alpha.1'
WHISTLE_BUILD_DATE='20261030'
WHISTLE_BUILD_NUMBER='1'
WHISTLE_VERSION_FULL="${WHISTLE_VERSION}+${WHISTLE_BUILD_DATE}.${WHISTLE_BUILD_NUMBER}"

whistle_version() {
  printf 'tmux-whistle %s\n' "$WHISTLE_VERSION_FULL"
}

# 版本查询必须在 lib、tmux、git 与 PATH 都不可用时也能工作。
case "${1:-}" in
--version | version)
  if [ "$#" -ne 1 ]; then
    printf 'tmux-whistle: 用法：%s --version\n' "$0" >&2
    exit 1
  fi
  whistle_version
  exit 0
  ;;
esac

# 解析符号链接后再定位 lib/。
# 安装时 bin/tmux-whistle 被链接到 ~/.local/bin，此时 $0 是链接路径，
# 直接 dirname 会得到 ~/.local/lib —— 找不到模块，整个 CLI 不可用。
# macOS 的 readlink 没有 -f，所以自己循环解析。
_whistle_self="$0"
while [ -L "$_whistle_self" ]; do
  _whistle_link=$(readlink "$_whistle_self") || break
  case "$_whistle_link" in
  /*) _whistle_self="$_whistle_link" ;;
  *) _whistle_self="$(dirname -- "$_whistle_self")/$_whistle_link" ;;
  esac
done
WHISTLE_BIN_DIR=$(CDPATH='' cd -- "$(dirname -- "$_whistle_self")" && pwd)
WHISTLE_LIB_DIR=$(CDPATH='' cd -- "$WHISTLE_BIN_DIR/../lib" && pwd)
unset _whistle_self _whistle_link

for _m in core status-line deliver menu; do
  if [ ! -f "$WHISTLE_LIB_DIR/$_m.sh" ]; then
    printf 'tmux-whistle: 缺少 lib/%s.sh（安装不完整？）\n' "$_m" >&2
    exit 1
  fi
  # shellcheck source=lib/core.sh
  . "$WHISTLE_LIB_DIR/$_m.sh"
done
unset _m

WHISTLE_PROG=$(basename "$0")
WHISTLE_SELF=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)/$WHISTLE_PROG

whistle_usage() {
  cat << EOF
$WHISTLE_PROG $WHISTLE_VERSION_FULL — tmux 内跨 session 的 agent 状态通知

状态分两条正交通道，互不顶掉：
  通知通道  done | wait | error      有事等你（待处理，会被 list / menu 列出）
  活动通道  running | idle           agent 在干什么（背景信息，不进待办清单）
一个 pane 可以同时「在跑」和「有事等你」—— 徽章显示优先级高的那条。

用法：
  $WHISTLE_PROG done|wait|error [消息]   写通知通道
  $WHISTLE_PROG running|idle [消息]      写活动通道
                                     （idle = 进程在但闲着；不会顶掉待处理通知）
  $WHISTLE_PROG run [-- 标签] -- 命令 [参数...]
                                     包一个命令：开始置 running（活动）；结束时
                                     活动回归 idle，按退出码落 done / error（通知），带耗时
  $WHISTLE_PROG clear [-a]           清除当前窗口 / 全部待处理状态
  $WHISTLE_PROG list                 列出所有待处理项
  $WHISTLE_PROG menu                 打开 agent 菜单（等同 prefix + n）
  $WHISTLE_PROG jump <窗口|序号|sess:win>
                                     跳到指定窗口并清除
  $WHISTLE_PROG on | off             总开关
  $WHISTLE_PROG doctor               环境自检
  $WHISTLE_PROG version | --version  显示完整版本（阶段 + 构建日期 + 流水号）

选项：
  -t, --target <pane|window>        指定目标（默认当前 pane）
      --title <短标题>              徽章上显示的文字（上限 80 字符）
      --body <正文>                完整内容，写进该通道的 body（通知 → @whistle_notice_body，
                                   活动 → @whistle_body；上限 400）
      --dry-run                     只打印会做什么，不执行

Claude Code 集成：
  $WHISTLE_PROG install-hooks [--dry-run] [--uninstall]

配置（tmux 里 set -g @whistle_xxx）：
  @whistle_enabled on|off            总开关（默认 on）
  @whistle_badge on|off              窗口标签徽章（默认 on）
  @whistle_border on|off             面板边框变色（默认 on）
  @whistle_display on|off            状态栏瞬时提示（默认 on）
  @whistle_os on|off                 桌面系统通知（默认 off）
  @whistle_os_app <bundle ID>        点击通知时激活的 macOS 应用（默认空）
  @whistle_self on|off               是否也提示自己所在的 session（默认 off）
  @whistle_clear_on_focus on|off     切进窗口自动清除（默认 on）
  @whistle_color_done|wait|error|running|idle   徽章与菜单颜色
  @whistle_color_pending             待处理总数的颜色（默认 #5fd7d7 青）
  @whistle_icon_done|wait|error|running    各状态的图标（默认 ◆ / ◔ / ⚠ / ▶）
  @whistle_icon_idle                 空闲状态的图标（默认 ◉；汇总与菜单共用）
  @whistle_icon_pending              全局计数前的图标（默认 ⚑；空串 = 不显示）
  @whistle_spin on|off               running 用 Braille 帧轮转（默认 on）
  @whistle_spin_interval 0.5         每帧间隔（秒）
  @whistle_sub_ttl 1800              子 agent 标记的存活秒数（0 = 永不过期）
  @whistle_agent_cmds "claude claude.exe"  哪些前台进程算 agent（按进程发现空闲用）
EOF
}

whistle_die() {
  printf '%s: %s\n' "$WHISTLE_PROG" "$*" >&2
  exit 1
}

# -- 置状态 ----------------------------------------------------------------

# whistle_state_write <状态> <消息> <正文> <目标 pane> → stdout = pane id
#
# 按状态分流到两条正交通道（模型见 lib/core.sh 顶部）：
#   done / wait / error → 通知通道（whistle_notice_set）
#   running / idle      → 活动通道（whistle_activity_set）
#
# 用户语法 done / running 与内部子命令 --activity / --notice 共用这一处 ——
# 分流规则只写一份，复制两份必然分叉。
#
# 未知状态不去猜通道：活动通道的写入点会拒绝并返回非零。
whistle_state_write() {
  _sw_state="$1"
  _sw_msg="$2"
  _sw_body="$3"
  _sw_target="$4"

  if whistle_is_notified "$_sw_state"; then
    whistle_notice_set "$_sw_state" "$_sw_msg" "$_sw_body" "$_sw_target"
  else
    whistle_activity_set "$_sw_state" "$_sw_target" "${WHISTLE_SRC:-manual}" \
      "$_sw_msg" "$_sw_body"
  fi
}

# whistle_finish <pane> <这次写的是哪条通道的状态>
#
# 写完状态之后的统一编排：重算窗口与全局派生值，然后投递。
# cmd_set / cmd_run / 子 agent 标记 / 内部子命令共用 —— 复制几份必然分叉。
#
# 第二个参数只用来区分「这次动的是通知通道还是活动通道」，投递的状态由
# 重算后的 @whistle_eff 决定：
#
#   - 通知写入（done / wait / error）：有效态就是它（rank 3~5，比重算后可能
#     还留着的 running / idle 都高），按有效态投递。瞬时提示与桌面通知会
#     扇出，这正是「有事等你」该有的行为。
#
#   - 活动写入（running / idle）：按**活动态**投递，不按有效态。
#     有效态可能是上一轮还没读掉的 done（rank 高于 running）；拿它投递的话，
#     每一次 PreToolUse 的 `--activity running` 都会把那条旧通知重新弹一遍。
#     边框与徽章读的是重算写进 option 的派生值，不依赖投递参数。
whistle_finish() {
  _ff_pane="$1"
  _ff_wrote="$2"

  _ff_win=$(whistle_pane_window "$_ff_pane")
  [ -n "$_ff_win" ] || return 1

  whistle_recompute_window "$_ff_win"
  whistle_recompute_global

  # 重算已经写好 @whistle_eff —— 读它，而不是在本函数里再算一遍 rank。
  _ff_eff=$(whistle_tmux show -pqv -t "$_ff_pane" @whistle_eff 2> /dev/null) || _ff_eff=''

  if whistle_is_activity "$_ff_wrote" && whistle_is_notified "$_ff_eff"; then
    # 活动通道的写入遇上了未读通知：不重新扇出那条旧通知
    _ff_msg=$(whistle_tmux show -pqv -t "$_ff_pane" @whistle_msg 2> /dev/null) || _ff_msg=''
    whistle_deliver "$_ff_win" "$_ff_wrote" "$(whistle_sanitize "$_ff_msg")" "$_ff_pane"
    return 0
  fi

  if whistle_is_notified "$_ff_eff"; then
    _ff_msg=$(whistle_tmux show -pqv -t "$_ff_pane" @whistle_notice_msg 2> /dev/null) || _ff_msg=''
  else
    _ff_msg=$(whistle_tmux show -pqv -t "$_ff_pane" @whistle_msg 2> /dev/null) || _ff_msg=''
  fi
  whistle_deliver "$_ff_win" "$_ff_eff" "$(whistle_sanitize "$_ff_msg")" "$_ff_pane"
}

# cmd_set <状态> [选项...] [消息...]
#
# 消息与选项的顺序无关 —— 早期版本直接把 $2 当消息，于是
# `done -t %3 "消息"`（git 那种习惯）会把 -t 吃进消息、写错 pane。
# 现在统一走一个循环：-t 收下一个参数，-- 之后全是消息，其余逐词拼消息。
cmd_set() {
  _state="$1"
  shift

  _msg=''
  _target=''
  _dry=0
  _title=''
  _body=''
  while [ $# -gt 0 ]; do
    case "$1" in
    -t | --target)
      _target="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    --title)
      _title="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    --body)
      _body="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    --dry-run)
      _dry=1
      shift
      ;;
    --)
      shift
      while [ $# -gt 0 ]; do
        _msg="${_msg:+$_msg }$1"
        shift
      done
      ;;
    -*)
      whistle_die "未知选项 [$1]"
      ;;
    *)
      # 内部子命令（--activity / --notice）的目标 pane 写在最后一个位置参数上
      # （hook 手上只有 pane id）。**只在 _cs_pane_hint 打开时**才这么认 ——
      # 用户语法里 `done %3` 仍是一句以 % 开头的消息，行为不变。
      if [ -n "${_cs_pane_hint:-}" ] && [ -z "$_target" ] && [ $# -eq 1 ]; then
        case "$1" in
        %*)
          _target="$1"
          shift
          continue
          ;;
        esac
      fi
      _msg="${_msg:+$_msg }$1"
      shift
      ;;
    esac
  done

  # 徽章上显示什么，优先级：--title > 位置消息 > --body 的前 80 字。
  # 三者都不给就是空 —— 与改动前逐字一致。
  # 之所以让 --body 能顶上来：只写 --body 时若消息留空，徽章就是空白，
  # 而正文的内容明明就在手上。
  if [ -n "$_title" ]; then
    _msg="$_title"
  elif [ -z "$_msg" ] && [ -n "$_body" ]; then
    _msg="$_body"
  fi

  if [ "$_dry" = 1 ]; then
    printf '将置 %s = "%s"（目标 %s）\n' "$_state" "$_msg" "${_target:-${TMUX_PANE:-当前 pane}}"
    return 0
  fi

  _pane=$(whistle_state_write "$_state" "$_msg" "$_body" "$_target") || exit 1
  whistle_finish "$_pane" "$_state" || whistle_die "拿不到 pane $_pane 所属窗口"
}

# -- 命令包装器 -------------------------------------------------------------

# cmd_run [-- 标签] [--target <pane>] -- 命令 [参数...]
#
# 替手写 `cmd && whistle done "…" || whistle error "…"`：那种写法漏了后半截
# 或把 && || 写反都**不报错**，只是徽章不对。包装器按退出码决定终态，
# 顺带把耗时记进消息。
#
# 只认退出码，不解析输出 —— 它没法知道一个退出码 0 的命令是不是"真的完成了"。
# 这是显式包装器的边界，不是缺陷。
#
# ⚠️ 不要用 exec：那会替换掉当前 shell 进程，拿不到退出码。
# 直接跑 "$@" 再读 $? 即可。
#
# ⚠️ 但必须给 SIGINT 装一个 no-op handler。Ctrl-C 把信号发给**整个前台进程组**，
# 不装的话 /bin/sh 跑的包装器会在读到 $? 之前就死掉 —— 状态永远停在 running，
# 而 running 不计入 pending、⚑ 不亮，非 Claude Code 的进程更没有 SessionEnd
# 兜底，那盏 ▶ 就再也灭不掉了。
#
# 必须用 ':'（no-op）而不是 ''（ignore）：被 **trap** 的信号在子进程里复位成
# 默认动作，子命令照样能被 Ctrl-C 打断；被 ignore 的信号会连子进程一起忽略 ——
# 那样用户按 Ctrl-C 就再也停不掉自己启动的构建了。
cmd_run() {
  trap ':' INT

  _label=''
  _target=''

  # 解析到 -- 为止：选项归选项，其余逐词拼成标签。
  while [ $# -gt 0 ]; do
    case "$1" in
    -t | --target)
      _target="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      whistle_die "未知选项 [$1]"
      ;;
    *)
      _label="${_label:+$_label }$1"
      shift
      ;;
    esac
  done

  [ $# -gt 0 ] \
    || whistle_die "用法：$WHISTLE_PROG run [-- 标签] -- 命令 [参数...]"

  # 没给标签就用命令名。$@ 原样传给 "$@" —— 不 eval、不 word splitting，
  # 用户引号怎么写就怎么传。
  _label="${_label:-$1}"

  # 开始：活动通道 running（「这个 pane 里有 agent 在干活」）
  _pane=$(whistle_state_write running "$_label" '' "$_target") || exit 1
  whistle_finish "$_pane" running || whistle_die "拿不到 pane $_pane 所属窗口"

  _start=$(whistle_now)
  "$@"
  _rc=$?
  _dur=$(($(whistle_now) - _start))

  if [ "$_rc" -eq 0 ]; then
    _state='done'
    _msg="$_label 完成（${_dur}s）"
  else
    _state='error'
    # ${_rc} 必须带括号：$_rc 紧跟全角逗号时 bash 会把「，」的第一个字节
    # 吞进变量名，字符串变成非法 UTF-8，tr 直接报 Illegal byte sequence
    # 并把消息截在逗号前。踩过，见 CLAUDE.md 的 POSIX sh 红线。
    _msg="$_label 失败（退出码 ${_rc}，${_dur}s）"
  fi

  # 结束：通知通道落 done / error，活动通道**熄成 idle**。
  #
  # 为什么活动通道必须熄：run 包装的是一条普通命令，它退出了，这个 pane 上
  # 就没有任何东西在干活。留着 running 会让状态栏永久转 ▶ —— 正是这次要
  # 根除的那类假信号（徽章亮着、其实什么也没发生）。
  #
  # idle 不会被「已读」抹掉、也不会顶掉通知；有效态仍取通知（done/error）。
  # 若子 agent 标记还有效，whistle_activity_set 会把 idle 折成 running —— 那是
  # core 的合成规则，这里不重复判断。
  whistle_state_write "$_state" "$_msg" '' "$_pane" > /dev/null
  whistle_state_write idle '' '' "$_pane" > /dev/null
  whistle_finish "$_pane" "$_state"

  # 透传子命令的退出码 —— 否则 `make && tmux-whistle run -- …` 失败时会返回 0。
  exit "$_rc"
}

# -- 清除 ------------------------------------------------------------------

# whistle_select_pane_if_alive <pane>
#
# 选中一个 pane，但**先判它还在不在**。不判的话，对着已死的 pane 发
# select-pane 会报错，而 tmux 的 `;` 命令链遇错即停 —— 后面的清除就不执行，
# 状态永远清不掉。
#
# 两个调用点都是这个 hazard：`jump`（用户手敲的窗口名）与菜单（开着的时候
# 那一格被关掉）。抽出来是为了两处共用同一套判断，别各写一份。
#
# 判存活用 display-message -p -t <pane>：不存在的 pane 会返回非零。
whistle_select_pane_if_alive() {
  _sp_pane="${1:-}"
  [ -n "$_sp_pane" ] || return 0
  whistle_tmux display-message -p -t "$_sp_pane" '#{pane_id}' > /dev/null 2>&1 || return 0
  whistle_tmux select-pane -t "$_sp_pane" 2> /dev/null || true
}

cmd_clear() {
  _all=0
  _target=''
  _select=''
  while [ $# -gt 0 ]; do
    case "$1" in
    -a | --all)
      _all=1
      shift
      ;;
    -t | --target)
      _target="$2"
      shift 2
      ;;
    --select)
      _select="${2:-}"
      shift 2 2> /dev/null || shift
      ;;
    *)
      _target="$1"
      shift
      ;;
    esac
  done

  if [ "$_all" = 1 ]; then
    whistle_clear_all
    whistle_border_release_all
    whistle_border_status_release_all
    whistle_refresh_all
    return 0
  fi

  _win=$(whistle_tmux display-message -p -t "${_target:-}" '#{window_id}' 2> /dev/null)
  [ -n "$_win" ] || _win=$(whistle_pane_window "$(whistle_resolve_pane "$_target")")
  [ -n "$_win" ] || whistle_die "找不到目标窗口"
  whistle_clear_window "$_win"
  whistle_border_release "$_win"
  whistle_border_status_release "$_win"
  whistle_refresh_sessions "$_win"

  # 菜单跳转会带 --select：先清、后选，即便 select 失败也不影响清除结果
  whistle_select_pane_if_alive "$_select"
}

# -- 列表 ------------------------------------------------------------------

cmd_list() {
  _rows=$(whistle_list_lines)
  if [ -z "$_rows" ]; then
    printf '没有待处理的 whistle。\n'
    return 0
  fi

  printf '%-14s %-12s %-5s %-8s %-8s %s\n' SESSION WINDOW PANE STATE MSG AGE
  # here-doc 重定向而非管道：管道会把循环塞进子 shell
  while IFS='|' read -r s w p st m a; do
    printf '%-14s %-12s %-5s %-8s %-8s %s\n' "$s" "$w" "$p" "$st" "$m" "$a"
  done << EOF
$_rows
EOF
  _n=$(printf '%s\n' "$_rows" | wc -l | tr -d ' ')
  printf '\n共 %s 项待处理。按 prefix + n 打开菜单跳转。\n' "$_n"
}

# -- 菜单 / 跳转 -----------------------------------------------------------

cmd_menu() {
  _items=$(whistle_agent_windows)
  if [ -z "$_items" ]; then
    # 两条路都要说一声：交互时 stdout 会被 run-shell -b 丢掉，只能靠
    # display-message 落到状态行；脚本里没有 client，则只能靠 stdout。
    printf '没有 agent 上报过状态。\n'
    whistle_tmux display-message '没有 agent 上报过状态' 2> /dev/null || true
    return 0
  fi

  # popup 标题由 UI 首行绘制；不用 tmux 3.3 才加入的 display-popup -T。
  # 命令串里显式引用 CLI 路径，安装路径带空格时仍只是一个程序名。
  if ! whistle_tmux display-popup -E "\"$WHISTLE_SELF\" --menu-ui" 2> /dev/null; then
    printf '没有可用的客户端。在 tmux 会话里按 prefix + n 打开菜单。\n\n'
    # 纯文本降级，没有菜单可选中，所以不带样式转义。
    while IFS='|' read -r s _wid wn _wi _pid eff _notice _activity msg; do
      printf '%s %s  [%s]: %s  %s\n' "$(whistle_menu_state_icon "$eff")" \
        "$(whistle_state_label "$eff")" "$s" "$wn" "$msg"
    done << EOF
$_items
EOF
  fi
}

# 调试/测试用：逐行打印菜单的 argv（每个参数一行）。
# 用于在不依赖 attached client 的情况下验证参数构造。
cmd_menu_args() {
  _items=$(whistle_agent_windows | whistle_menu_model)
  [ -n "$_items" ] || return 0

  # 模型行的消息仍在末位；溢出行只有类型与隐藏数两列。
  while IFS='|' read -r _kind _key _wid _pid _s _wn _eff _msg; do
    case "$_kind" in
    item)
      printf '%s\n' "$(whistle_menu_item_label "$_eff" "$_s" "$_wn" "$_msg")"
      printf '%s\n' "$_key"
      printf '%s\n' "switch-client -t $_s ; select-window -t $_wid ; run-shell -b '$WHISTLE_SELF clear -t $_wid --select $_pid'"
      ;;
    overflow)
      printf '%s\n' "$(whistle_menu_overflow "$_key")"
      printf '%s\n' ''
      printf '%s\n' "display-message ''"
      ;;
    esac
  done << EOF
$_items
EOF
}

cmd_jump() {
  [ -n "${1:-}" ] || whistle_die "用法：$WHISTLE_PROG jump <窗口名|窗口序号|session:窗口>"
  _target="$1"

  # 认四种形式：session:窗口名、session:窗口序号、裸窗口名、裸窗口序号。
  # 裸窗口名是 list 输出的第二列，用户会照着抄 —— 不认它就等于报错说
  # 「找不到」，而那个窗口明明就在那儿。
  #
  # **撞名时报错列候选，不静默取第一个**：裸序号 0 在每个 session 里都存在，
  # 裸窗口名也可能重名。跳错窗口比报错难查得多 —— 你到了另一个 session，
  # 看见一个干净窗口，根本想不起来「哦原来该跳的是另一个」。
  #
  # 一个窗口最多命中一支（$3 == t 与 $4 == t 互斥：窗口名不可能等于序号）。
  # 候选一律显示 session:窗口名，用户能直接粘回来用。
  _hits=$(whistle_tmux list-windows -a \
    -F '#{session_name}|#{window_id}|#{window_name}|#{window_index}' 2> /dev/null \
    | awk -F'|' -v t="$_target" \
      '$1 ":" $3 == t || $1 ":" $4 == t || $3 == t || $4 == t { print $2 "|" $1 ":" $3 }')

  [ -n "$_hits" ] || whistle_die "找不到 [$_target]"

  _n=$(printf '%s\n' "$_hits" | wc -l | tr -d ' ')
  if [ "$_n" -gt 1 ]; then
    _list=$(printf '%s\n' "$_hits" | cut -d'|' -f2 | sort)
    printf '%s: [%s] 匹配到 %s 个窗口，请写 session:window：\n' \
      "$WHISTLE_PROG" "$_target" "$_n" >&2
    printf '%s\n' "$_list" | sed 's/^/  /' >&2
    exit 1
  fi

  _wid=${_hits%%|*}
  whistle_tmux switch-client -t "$_wid" 2> /dev/null || true

  # 顺带选中报状态的那一格。
  # **必须先判存活**：select-pane 对着已死的 pane 会报错，而 tmux 的 `;`
  # 命令链遇错即停 —— 后面的 whistle_clear_window 就不会执行，状态永远清不掉。
  # 这正是「菜单开着的时候那一格被关掉」的场景。判断逻辑与菜单路径共用。
  whistle_select_pane_if_alive "$(whistle_tmux show -wv -t "$_wid" @whistle_win_pane 2> /dev/null)"

  whistle_clear_window "$_wid"
}

# 桌面通知点击：严格跳转全部成功后，才复用 cmd_clear 的
# window 级已读、边框释放与刷新。不能借用会忽略切换错误的 cmd_jump。
cmd_desktop_jump() {
  _cdj_pane="${1:-}"
  [ -n "$_cdj_pane" ] || whistle_die "用法：$WHISTLE_PROG --desktop-jump <pane>"
  whistle_desktop_jump "$_cdj_pane" || return 1
  cmd_clear -t "$_cdj_pane"
}

# -- 开关 ------------------------------------------------------------------

cmd_toggle() {
  _v=$1
  case "$_v" in
  on | off) ;;
  *) whistle_die "用法：$WHISTLE_PROG on|off" ;;
  esac
  whistle_tmux set -g @whistle_enabled "$_v"
  whistle_tmux display-message "whistle: $_v"
}

# -- 内部子命令（供 hook / 绑定调用） ---------------------------------------

cmd_recompute() {
  _wins=$(whistle_tmux list-windows -a -F '#{window_id}' 2> /dev/null)
  for _w in $_wins; do
    whistle_recompute_window "$_w"
  done
  whistle_recompute_global
}

# -- 内部子命令：双通道写入（只给 hook 用） ---------------------------------
#
# 这几个名字与参数形态是**冻结契约**（hooks/claude-code.sh 按它调用），
# 不写进 whistle_usage 的用户语法 —— 用户该用的是 done / running。
#
#   tmux-whistle --activity <running|idle|gone> [pane]
#   tmux-whistle --notice   <done|wait|error> [msg] [--body <正文>] [pane]
#   tmux-whistle --sub-agent-start [pane]
#   tmux-whistle --sub-agent-stop  [pane]
#
# --activity / --notice 与用户语法走**同一条实现**（cmd_set）；
# 唯一的差别是最后一个位置参数写成 %N 时当目标 pane —— hook 手上只有
# pane id，而把 `%3` 混进消息会让状态写到 $TMUX_PANE 上去，不报错、写错格子。
cmd_activity() {
  case "${1:-}" in
  running | idle | gone) ;;
  *) whistle_die "用法：$WHISTLE_PROG --activity <running|idle|gone> [pane]" ;;
  esac
  _cs_pane_hint=1
  cmd_set "$@"
}

cmd_notice() {
  case "${1:-}" in
  done | wait | error) ;;
  *) whistle_die "用法：$WHISTLE_PROG --notice <done|wait|error> [消息] [--body <正文>] [pane]" ;;
  esac
  _cs_pane_hint=1
  cmd_set "$@"
}

# cmd_sub_agent <start|stop> [pane]
#
# 只写 @whistle_sub（存**过期时间戳**），**不写 @whistle**：活动态由推导层
# 合成（标记有效 → 强制 running）。写了就分不清「主回合在跑」和「只是子
# agent 在跑」，子 agent 结束（stop）时那份 running 会永远留下来。
#
# 写完之后仍要走一次重算 + 投递：活动态变了，徽章与计数得跟上。
# 投递按活动态走（不是有效态）—— 子 agent 结束不该把用户没读的通知重播一遍。
cmd_sub_agent() {
  _sa_act="$1"
  _sa_pane=$(whistle_sub_set "$_sa_act" "${2:-}") || exit 1
  case "$_sa_act" in
  start) whistle_finish "$_sa_pane" running ;;
  *) whistle_finish "$_sa_pane" idle ;;
  esac
}

cmd_read_window() {
  _win="${1:-}"
  [ -n "$_win" ] || return 0
  whistle_read_window "$_win" || return 0
  whistle_border_release "$_win"
  whistle_border_status_release "$_win"
  whistle_refresh_sessions "$_win"
}

cmd_read_pane() {
  _pane="${1:-}"
  [ -z "$_pane" ] && _pane=$(whistle_resolve_pane '')
  [ -z "$_pane" ] && return 1

  # 先看是否真的待处理，避免无谓的重算与重绘。
  # **判据是通知通道**（@whistle_notice）—— @whistle 里是活动态
  # （running / idle / gone），永远不是待处理态；拿它当判据会让
  # 「已读」永远清不掉任何通知。
  _s=$(whistle_tmux show -pqv -t "$_pane" @whistle_notice 2> /dev/null)
  whistle_is_notified "$_s" || return 0

  whistle_read_pane "$_pane" || return 0
  _win=$(whistle_pane_window "$_pane")
  whistle_border_release "$_win"
  whistle_border_status_release "$_win"
  whistle_refresh_sessions "$_win"
}

# agent 退出（SessionEnd hook）时收尾这个 pane。
#
# 「正在干活」（running）和「空闲待命」（idle）两个标记都该灭 —— 否则窗口会
# 一直亮 ▶ 或 ◉。但**不能直接清空**：钩子跑的时候 agent 进程还没退出，
# pane_current_command 仍是 claude，清空的话紧接着的重算会又把它当成空闲。
# 所以写成 gone（见 whistle_forget_agent）。
#
# 待处理通知（done/wait/error）一律不动：agent 退出不代表你已经看过。
cmd_forget_agent() {
  _pane="${1:-}"
  [ -z "$_pane" ] && _pane=$(whistle_resolve_pane '')
  [ -z "$_pane" ] && return 0

  _win=$(whistle_forget_agent "$_pane") || return 0
  [ -n "$_win" ] || return 0

  # 窗口里没有待处理状态时才还原边框。idle / running / gone 都不染边框
  # （只有「有事等你」才染），所以它们在窗口里时边框也该还原。
  _left=$(whistle_tmux show -wv -t "$_win" @whistle_win 2> /dev/null) || _left=''
  case "$_left" in
  done | wait | error) ;;
  *)
    whistle_border_release "$_win"
    whistle_border_status_release "$_win"
    ;;
  esac
  whistle_refresh_sessions "$_win"
}

cmd_print_status_line() {
  whistle_print_status_line
}

# -- doctor ----------------------------------------------------------------

cmd_doctor() {
  _ok=0
  _warn=0

  _ok_line() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
  _warn_line() {
    printf '  \033[33m!\033[0m %s\n' "$1"
    _warn=$((_warn + 1))
  }
  _bad_line() {
    printf '  \033[31m✗\033[0m %s\n' "$1"
    _ok=1
  }

  printf '\n%s doctor\n\n' "$(whistle_version)"

  printf 'tmux\n'
  if ! command -v tmux > /dev/null 2>&1; then
    _bad_line 'tmux 不在 PATH'
  else
    _ver=$(tmux -V | awk '{print $2}')
    _ok_line "tmux $_ver"
    _maj=${_ver%%.*}
    _min=$(printf '%s' "$_ver" | cut -d. -f2)
    if [ "$_maj" -lt 3 ] || { [ "$_maj" -eq 3 ] && [ "$_min" -lt 2 ]; }; then
      _bad_line '需要 tmux >= 3.2（run-shell -b / refresh-client -S / pane-border-status）'
    fi
    if ! whistle_tmux display-message -p '#{session_id}' > /dev/null 2>&1; then
      _bad_line '连不上 tmux server（在 tmux 内运行，或设置 TMUX_SOCKET）'
    fi
  fi

  # -- 多个 tmux server：会静默关掉 tmux-continuum --------------------------
  #
  # tmux-continuum 的**自动恢复**与**自动保存**都以「本机只有一个 tmux server」
  # 为前提：`continuum_restore.sh` 与 `continuum.tmux` 里各有一道
  # `another_tmux_server_running` 门，不满足就**静默跳过**（设计意图是怕两个
  # 环境互相覆盖存档）。症状是「重启 tmux 后会话恢复不出来」，而且状态栏上看
  # 不出任何异常 —— 所以这里必须明说。
  #
  # 判据与 continuum 逐字一致：除当前 server 外的 tmux 进程数 > 当前 client 数。
  # ⚠️ 不能数 socket 文件：socket 可能残留，而 server 早没了。
  printf '\n多个 tmux server（影响 tmux-continuum 的自动恢复/自动保存）\n'
  _dg_uid=$(id -u)
  # 刻意用 ps 而不是 pgrep：这里要**复刻 continuum 自己的判据**
  # （`ps -u <uid> -o command | grep '^tmux'`）。换成 pgrep 会得到另一个数，
  # 报出来的结论就和 continuum 的实际决定对不上了 —— 那才是最坏的情况：
  # doctor 说没问题，而自动恢复其实早就被关掉了。
  # shellcheck disable=SC2009
  _dg_procs=$(ps -u "$_dg_uid" -o command= 2> /dev/null | grep -c '^tmux' || true)
  _dg_clients=$(whistle_tmux list-clients -F '#{client_name}' 2> /dev/null | wc -l | tr -d ' ')
  case "$_dg_procs" in '' | *[!0-9]*) _dg_procs=0 ;; esac
  case "$_dg_clients" in '' | *[!0-9]*) _dg_clients=0 ;; esac
  if [ $((_dg_procs - 1)) -gt "$_dg_clients" ]; then
    _warn_line "本机还有别的 tmux server（tmux 进程 ${_dg_procs} 个，本 server 的 client ${_dg_clients} 个）"
    printf '    → tmux-continuum 会认为「另一个 server 在跑」，静默关闭自动恢复与自动保存。\n'
    printf '    → 查是哪个：ps -u %s -o pid=,command= | grep tmux\n' "$_dg_uid"
    printf '    → 清掉：tmux -L <上一步看到的 socket 名> kill-server\n'
  else
    _ok_line "只有本 server（tmux 进程 ${_dg_procs} 个，client ${_dg_clients} 个）"
  fi

  printf '\n状态栏\n'
  _fmt=$(whistle_tmux show -gwv window-status-format 2> /dev/null)
  _n=$(printf '%s' "$_fmt" | grep -o -F "$WHISTLE_MARK_SENTINEL" | wc -l | tr -d ' ')
  if [ "$_n" = 1 ]; then
    _ok_line '徽章已注入 window-status-format'
  elif [ "$_n" -gt 1 ]; then
    _bad_line "哨兵出现 $_n 次（重复注入了）—— 跑 install.sh --uninstall 后重装"
  else
    _warn_line '未注入。跑 make install，或手动加 tmux_conf_theme_window_status_format'
  fi

  printf '\n投递渠道\n'
  for _c in badge border display os; do
    _v=$(whistle_conf "@whistle_$_c")
    printf '  %-8s %s\n' "$_c" "$_v"
  done

  if [ "$(whistle_conf '@whistle_os')" = on ]; then
    if command -v terminal-notifier > /dev/null 2>&1; then
      _dg_tn_ver=$(terminal-notifier -version 2> /dev/null)
      _dg_tn_major=$(printf '%s\n' "$_dg_tn_ver" | sed -n 's/^terminal-notifier \([0-9][0-9]*\)\..*$/\1/p')
      case "$_dg_tn_major" in
      [3-9] | [1-9][0-9]*)
        _dg_tn_diag=$(terminal-notifier -diagnose 2>&1)
        _dg_tn_rc=$?
        printf '%s\n' "$_dg_tn_diag" | sed 's/^/    /'
        if [ "$_dg_tn_rc" -eq 0 ]; then
          _ok_line 'terminal-notifier 已授权（其它投递设置见上方诊断）'
        else
          _warn_line 'terminal-notifier 未授权或诊断失败：系统设置 → 通知 → terminal-notifier'
        fi
        ;;
      *)
        _warn_line "terminal-notifier 版本较旧或无法识别（${_dg_tn_ver:-未知}），建议升级到 3.x 以使用 -diagnose"
        ;;
      esac
    elif command -v osascript > /dev/null 2>&1; then
      osascript -e 'display notification "tmux-whistle doctor 测试" with title "tmux-whistle"' \
        > /dev/null 2>&1 || true
      _warn_line '已发 osascript 测试通知。没看到弹窗 → 系统设置 > 通知 > Script Editor 打开"允许通知"'
    elif command -v notify-send > /dev/null 2>&1; then
      notify-send 'tmux-whistle' 'doctor 测试' > /dev/null 2>&1 || true
      _ok_line 'notify-send 可用'
    else
      _bad_line '没有可用的桌面通知命令'
    fi
  else
    _warn_line '@whistle_os 是 off。要开：set -g @whistle_os on'
  fi

  printf '\n已读钩子\n'
  for _h in after-select-window after-select-pane window-pane-changed; do
    if whistle_tmux show-hooks -gw "$_h" 2> /dev/null | grep -q whistle; then
      _ok_line "$_h 已注册"
    else
      _warn_line "$_h 未注册"
    fi
  done

  printf '\nClaude Code hooks\n'
  _settings="${HOME}/.claude/settings.json"
  if [ -f "$_settings" ]; then
    if grep -q 'tmux-whistle' "$_settings" 2> /dev/null; then
      _ok_line "$_settings 已配置"
    else
      _warn_line '未配置。跑 tmux-whistle install-hooks'
    fi
  else
    _warn_line "找不到 $_settings"
  fi

  printf '\n失效的旧绑定\n'
  # list-keys 的输出是多空格对齐的（"bind-key    -T prefix C-m     ..."），
  # 所以模式必须容忍任意空白，不能用单个空格。
  _stale=0
  for _k in C-m M-m M; do
    _cmd=$(whistle_tmux list-keys -T prefix 2> /dev/null \
      | grep -E "prefix +${_k} +" | grep -F 'tmux-notify' || true)
    [ -n "$_cmd" ] || continue

    # 从命令里抠出脚本路径
    _path=$(printf '%s' "$_cmd" | grep -oE '/[^ "'"'"']*tmux-notify[^ "'"'"']*' | head -1)
    _dir=${_path%/*}
    if [ -n "$_dir" ] && [ -d "$_dir" ]; then
      printf '  - prefix %s → tmux-notify（目录存在）\n' "$_k"
    else
      printf '  \033[33m!\033[0m prefix %s → tmux-notify，但脚本已不存在。跑 install.sh --cleanup 清理。\n' "$_k"
      _warn=$((_warn + 1))
      _stale=1
    fi
  done
  [ "$_stale" = 1 ] || printf '  - 无\n'

  printf '\n'
  if [ "$_ok" = 1 ]; then
    printf '有问题项请先修掉再继续。\n\n'
    exit 1
  fi
  if [ "$_warn" -gt 0 ]; then
    printf '%s 项提醒（非致命）。\n\n' "$_warn"
  else
    printf '一切正常。\n\n'
  fi
}

# -- 分派 ------------------------------------------------------------------

[ $# -gt 0 ] || {
  whistle_usage
  exit 1
}

case "$1" in
done | wait | error | running | idle)
  cmd_set "$@"
  ;;
run)
  shift
  cmd_run "$@"
  ;;
clear)
  shift
  cmd_clear "$@"
  ;;
list | ls)
  shift
  cmd_list "$@"
  ;;
menu)
  shift
  cmd_menu "$@"
  ;;
jump)
  shift
  cmd_jump "$@"
  ;;
on | off)
  # 必须先用 $1 再 shift —— 先 shift 会把子命令本身吃掉
  cmd_toggle "$1"
  ;;
doctor)
  shift
  cmd_doctor "$@"
  ;;
install-hooks)
  shift
  exec "$WHISTLE_BIN_DIR/../lib/install-hooks.sh" "$@"
  ;;
-h | --help | help)
  whistle_usage
  ;;
--desktop-jump)
  shift
  cmd_desktop_jump "${1:-}"
  ;;
--read-window)
  shift
  cmd_read_window "${1:-}"
  ;;
--read-pane)
  shift
  cmd_read_pane "${1:-}"
  ;;
--clear-pane)
  shift
  cmd_forget_agent "${1:-}"
  ;;
--activity)
  shift
  cmd_activity "$@"
  ;;
--notice)
  shift
  cmd_notice "$@"
  ;;
--sub-agent-start)
  shift
  cmd_sub_agent start "$@"
  ;;
--sub-agent-stop)
  shift
  cmd_sub_agent stop "$@"
  ;;
--recompute)
  shift
  cmd_recompute
  ;;
--print-status-line)
  shift
  cmd_print_status_line
  ;;
--menu-ui)
  shift
  whistle_menu_ui "$@"
  ;;
--menu-args)
  shift
  cmd_menu_args
  ;;
*)
  whistle_usage
  exit 1
  ;;
esac
